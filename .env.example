# Application Server
PORT=8080
APP_ENV=development
APP_URL=http://localhost:8080
SESSION_KEY=your-32-byte-secret-session-key-change-me

# PostgreSQL Database (matches docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/halisi?sslmode=disable

# Google OAuth2 Authentication (leave placeholder for offline dev)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Maps API (For Geocoding & Interactive Shop Map)
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyPlaceholder

# Safaricom M-Pesa Daraja Credentials (Sandbox)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_sandbox_consumer_key
MPESA_CONSUMER_SECRET=your_sandbox_consumer_secret
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=http://localhost:8080/api/payments/mpesa/callback

# Transactional Email (Points to local Mailpit container)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@halisi.co.ke

# Object Storage (Local disk for dev; AWS S3 / Cloudflare R2 for prod)
STORAGE_PROVIDER=local
S3_BUCKET=halisi-documents
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
