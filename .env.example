PORT=8080
DATABASE_URL=postgres://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8080
# Local Mailpit: docker run --rm -p 127.0.0.1:1025:1025 -p 127.0.0.1:8025:8025 axllent/mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS_MODE=none
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional Google Web application credentials; leave both empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VENDOR_DOCUMENT_DIR=.data/vendor-documents
