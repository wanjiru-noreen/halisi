package webtempl

import "halisi/internal/models"

type AdminData struct {
	TotalUsers  int
	TotalShops  int
	TotalOrders int
	Users       []models.User
	Shops       []models.Shop
	Orders      []models.Order
}

templ AdminDashboard(data AdminData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<title>Admin Dashboard | Halisi</title>
			<link rel="stylesheet" href="/static/css/style.css">
			<link rel="preconnect" href="https://fonts.googleapis.com">
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
			<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		</head>
		<body>
			<header class="navbar">
				<div class="logo">HALISI ADMIN</div>
				<nav>
					<a href="/admin">Dashboard</a>
					<a href="/logout">Logout</a>
				</nav>
			</header>
			<main class="admin-page">
				<h1>Dashboard Overview</h1>
				<div class="stats-grid">
					<div class="stat-card">
						<h2>{data.TotalUsers}</h2>
						<p>Users</p>
					</div>
					<div class="stat-card">
						<h2>{data.TotalShops}</h2>
						<p>Gas Shops</p>
					</div>
					<div class="stat-card">
						<h2>{data.TotalOrders}</h2>
						<p>Orders</p>
					</div>
				</div>
				<section class="admin-section">
					<h2>Shop Verification</h2>
					<table>
						<tr>
							<th>Shop</th>
							<th>Location</th>
							<th>Phone</th>
							<th>Status</th>
							<th>Action</th>
						</tr>
						{if len(data.Shops) > 0}
						{range data.Shops}
						<tr>
							<td>{.Name}</td>
							<td>{.Location}</td>
							<td>{.Phone}</td>
							<td>{.VerificationStatus}</td>
							<td>
								{if .VerificationStatus == "pending"}
								<form method="POST" action="/admin/verify-shop" style="display:inline;">
									<input type="hidden" name="shop_id" value="{.ID}">
									<input type="hidden" name="status" value="approved">
									<button type="submit">Approve</button>
								</form>
								<form method="POST" action="/admin/verify-shop" style="display:inline;">
									<input type="hidden" name="shop_id" value="{.ID}">
									<input type="hidden" name="status" value="rejected">
									<button type="submit">Reject</button>
								</form>
								{else}
								No action
								{end}
							</td>
						</tr>
						{end}
						{else}
						<tr>
							<td colspan="5">No shops registered.</td>
						</tr>
						{end}
					</table>
				</section>
				<section class="admin-section">
					<h2>Recent Orders</h2>
					<table>
						<tr>
							<th>ID</th>
							<th>User</th>
							<th>Shop</th>
							<th>Status</th>
						</tr>
						{range data.Orders}
						<tr>
							<td>{.ID}</td>
							<td>{.UserID}</td>
							<td>{.ShopID}</td>
							<td>{.Status}</td>
						</tr>
						{end}
					</table>
				</section>
				<section class="admin-section">
					<h2>Registered Users</h2>
					<table>
						<tr>
							<th>Name</th>
							<th>Email</th>
							<th>Role</th>
						</tr>
						{range data.Users}
						<tr>
							<td>{.Name}</td>
							<td>{.Email}</td>
							<td>{.Role}</td>
						</tr>
						{end}
					</table>
				</section>
			</main>
			<footer>
				© 2026 Halisi
			</footer>
		</body>
	</html>
}
