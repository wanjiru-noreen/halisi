package webtempl

import (
	"fmt"
	"halisi/internal/models"
)

type ShopOrdersData struct {
	Shop   models.Shop
	Orders []models.Order
	Role   string
}

templ ShopOrdersPage(data ShopOrdersData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Incoming Orders | Halisi</title>
			<link rel="stylesheet" href="/static/css/style.css"/>
		</head>
		<body>
			@VendorNavbar()
			<main class="shop-orders-page">
				<div class="shop-orders-container">
					<div class="page-header">
						<h1>{ data.Shop.Name }</h1>
						<p>{ data.Shop.Location }</p>
					</div>
					<div class="section-title">
						<h3>Incoming Orders</h3>
						<p>Review customer orders and update their delivery status.</p>
					</div>
					if len(data.Orders) > 0 {
						for _, order := range data.Orders {
							<article class="order-card">
								<div class="order-card-header">
									<div>
										<span class="eyebrow">Order #{ order.ID }</span>
										<h3>Customer #{ order.UserID }</h3>
									</div>
									<span class={ "status " + order.Status }>{ order.Status }</span>
								</div>
								<div class="order-details">
									<div class="detail-box">
										<span class="detail-label">Customer</span>
										<span class="detail-value">#{ order.UserID }</span>
									</div>
									<div class="detail-box">
										<span class="detail-label">Gas</span>
										<span class="detail-value">{ order.CylinderSize }</span>
									</div>
									<div class="detail-box">
										<span class="detail-label">Quantity</span>
										<span class="detail-value">{ order.Quantity }</span>
									</div>
									<div class="detail-box">
										<span class="detail-label">Total</span>
										<span class="detail-value">KSh { order.TotalPrice }</span>
									</div>
									<div class="detail-box">
										<span class="detail-label">Delivery Address</span>
										<span class="detail-value">{ order.DeliveryAddress }</span>
									</div>
								</div>
								<div class="status-section">
									<div class="current-status">
										<strong>Current Status:</strong>
										<span class={ "status " + order.Status }>{ order.Status }</span>
									</div>
									<form method="POST" action="/orders/update" class="status-form">
										<input type="hidden" name="id" value={ order.ID }/>
										<div class="status-field">
											<label for={ fmt.Sprintf("status-%d", order.ID) }>Update Status</label>
											<select id={ fmt.Sprintf("status-%d", order.ID) } name="status" class="status-select" required>
												<option value="Pending" selected?={ order.Status == "Pending" }>Pending</option>
												<option value="Accepted" selected?={ order.Status == "Accepted" }>Accepted</option>
												<option value="Preparing" selected?={ order.Status == "Preparing" }>Preparing</option>
												<option value="Out for Delivery" selected?={ order.Status == "Out for Delivery" }>Out for Delivery</option>
												<option value="Delivered" selected?={ order.Status == "Delivered" }>Delivered</option>
												<option value="Rejected" selected?={ order.Status == "Rejected" }>Rejected</option>
											</select>
										</div>
										<button type="submit" class="update-status-btn">Update Status</button>
									</form>
								</div>
							</article>
						}
					} else {
						<div class="empty-orders">
							<h3>No Incoming Orders</h3>
							<p>There are currently no customer orders for this shop.</p>
						</div>
					}
					<div class="actions">
						<a href="/shop/manage" class="action-btn manage-btn">Manage Shop Prices</a>
						<a href="/logout" class="action-btn logout-btn">Logout</a>
					</div>
				</div>
			</main>
			<footer class="site-footer">
				<p>© 2026 Halisi. All Rights Reserved.</p>
			</footer>
		</body>
	</html>
}
