# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure LF line endings for Go, Templ, Docker, CI, and shell scripts
*.go text eol=lf
*.templ text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
